{
  "kind": "singleType",
  "collectionName": "parish_pages",
  "info": {
    "singularName": "parish-page",
    "pluralName": "parish-pages",
    "displayName": "Parish Page",
    "description": "Hub stránka Farnosť (/farnost) — sekcie sviatostí sú súčasťou sections dynamic zone priamo na tejto stránke, nie samostatné podstránky"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "heroEyebrow": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroTitle": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.quick-nav",
        "sections.announcements-preview",
        "sections.image-text",
        "sections.rich-text",
        "sections.faq"
      ],
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
