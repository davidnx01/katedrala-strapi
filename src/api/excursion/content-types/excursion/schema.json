{
  "kind": "collectionType",
  "collectionName": "excursions",
  "info": {
    "singularName": "excursion",
    "pluralName": "excursions",
    "displayName": "Excursion",
    "description": "Archív odoslaní z ExcursionForm (objednávka exkurzie pre skupiny)"
