    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "preferredDate": {
      "type": "date"
    },
    "groupSize": {
      "type": "integer"
    },
    "message": {
      "type": "text"
    },
    "locale": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": ["new", "confirmed", "cancelled"],
      "default": "new"
    }
  }
}
