{
  "kind": "collectionType",
  "collectionName": "churches",
  "info": {
    "singularName": "church",
    "pluralName": "churches",
    "displayName": "Kostoly a kaplnky",
    "description": "Kostoly a kaplnky na území farnosti"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "type": {
      "type": "enumeration",
      "enum": ["kostol", "kaplnka"],
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "address": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "rector": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "email": {
      "type": "email",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "phone": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "massSchedule": {
      "type": "component",
      "repeatable": true,
      "component": "shared.mass-time",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "about": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "announcementsUrl": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "latitude": {
      "type": "decimal",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "longitude": {
      "type": "decimal",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
