{
  "kind": "singleType",
  "collectionName": "visit_pages",
  "info": {
    "singularName": "visit-page",
    "pluralName": "visit-pages",
    "displayName": "Visit Page",
    "description": "Hub stránka Návšteva (/navsteva) — info pre turistov + MainSquare/Wallet integrácia"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "heroEyebrow": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroTitle": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "mainSquareUrl": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "walletCardUrl": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "qrCodeReservation": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "qrCodeWallet": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.rich-text",
        "sections.image-text",
        "sections.cta-banner",
        "sections.faq",
        "sections.gallery"
      ],
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
