{
  "kind": "singleType",
  "collectionName": "contact_pages",
  "info": {
    "singularName": "contact-page",
    "pluralName": "contact-pages",
    "displayName": "Contact Page",
    "description": "Stránka Kontakt (/kontakt)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "heroEyebrow": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "heroTitle": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "locations": {
      "type": "component",
      "repeatable": true,
      "component": "shared.contact-location",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "sections": {
      "type": "dynamiczone",
      "components": ["sections.rich-text", "sections.cta-banner", "sections.faq"],
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
