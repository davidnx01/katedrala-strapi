{
  "kind": "collectionType",
  "collectionName": "contact_messages",
  "info": {
    "singularName": "contact-message",
    "pluralName": "contact-messages",
    "displayName": "Správy z kontaktného formulára",
    "description": "Archív odoslaní z ContactForm"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "locale": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": ["new", "read", "archived"],
      "default": "new"
    }
  }
}
