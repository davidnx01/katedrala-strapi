{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Udalosti (kalendár)",
    "description": "Udalosti pre kalendár na homepage (sväté omše, koncerty, sviatky, prehliadky, stretnutia...)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "date": {
      "type": "date",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "category": {
      "type": "enumeration",
      "enum": ["pohreb", "koncert", "sukromna_exkurzia", "krst", "omsa", "adoracia", "sobas", "lectio", "prehliadka"],
      "required": true,
      "description": "Určuje farbu bodky v kalendári — mapovanie farieb je vo frontend kóde (lib/event-categories.ts)",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "timeFrom": {
      "type": "time",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "timeTo": {
      "type": "time",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "location": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "text",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
