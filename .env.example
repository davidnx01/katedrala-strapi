# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=1337

# --- Bezpečnostné kľúče Strapi ----------------------------------------------
# Toto sú interné šifrovacie/podpisové kľúče Strapi (nič, čo si musíš
# pamätať) — pri prvom nasadení si každý z nich vygeneruj vlastný náhodný
# reťazec a NIKDY nepoužívaj hodnoty nižšie ani hodnoty z iného nasadenia.
# Najjednoduchšie: `openssl rand -base64 32` (spusti 6× pre 6 riadkov nižšie,
# APP_KEYS potrebuje 2 hodnoty oddelené čiarkou).
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- CORS --------------------------------------------------------------------
# Zoznam domén webu (frontendu), ktoré smú volať toto API — oddelené čiarkou,
# BEZ lomítka na konci, NIKDY nedávaj '*'. Sem príde skutočná verejná adresa
# webu, keď bude nasadený (napr. https://katedralabratislava.sk).
FRONTEND_URLS=http://localhost:3000

# --- Databáza ------------------------------------------------------------
# Bez zásahu = SQLite (súbor .tmp/data.db, netreba nič inštalovať ani
# nastavovať) — najjednoduchšia voľba, stačí na malý až stredný web.
#
# Ak chceš namiesto toho Postgres alebo MySQL, odkomentuj a vyplň nižšie:
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
